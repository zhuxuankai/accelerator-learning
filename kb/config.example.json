{
  "version": 2,
  "include_dirs": ["课程一", "课程二", "文献"],
  "exclude": ["kb", "tools", "学习路线", "extensions", "examples", "tests"],
  "index": {
    "chunk_size": 700,
    "chunk_overlap": 70,
    "embedding_model": "intfloat/multilingual-e5-small",
    "rrf_k": 60,
    "candidate_k": 50,
    "max_chunks_per_doc": 3
  },
  "model": {
    "allow_download": false
  },
  "ocr": {
    "enabled": true,
    "dpi": 220,
    "language": "chi_sim+eng",
    "model_version": "rapidocr-v1",
    "min_confidence": 0.6,
    "min_chars": 40,
    "max_replacement_ratio": 0.05,
    "max_noise_ratio": 0.32
  },
  "reading": {
    "stage": "foundation",
    "slots": [
      {"category": "review", "mode": "精读"},
      {"category": "group", "mode": "泛读"}
    ]
  },
  "weekly": {
    "eval_required": true,
    "eval_suite": "local",
    "eval_split": "dev",
    "max_review_candidates": 1,
    "thresholds": {
      "page_hit_at_3": 0.8,
      "recall_at_50": 0.9,
      "empty_rate_max": 0.1
    }
  },
  "translate": {
    "enabled": false,
    "out_dir": "文献/译文"
  },
  "papers": {
    "inspire_author_recid": null,
    "openalex_author_id": "",
    "since_year": 2020,
    "mailto": "your-email@example.com",
    "target_count": 70,
    "coauthors": ["Author One", "Author Two"],
    "topic_keywords": ["free-electron laser", "beam dynamics", "linac", "synchrotron radiation"],
    "classics": []
  }
}
